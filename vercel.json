{
  "buildCommand": "npm run build:all",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/dashboard/:path*"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}

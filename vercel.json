{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "env": {
    "VITE_API_URL": "https://hyperlynx-backend.onrender.com/HL/content/v1"
  },
  "build": {
    "env": {
      "VITE_API_URL": "https://hyperlynx-backend.onrender.com/HL/content/v1"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}